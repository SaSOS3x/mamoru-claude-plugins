# Text files are LF in git AND in the working copy, whatever core.autocrlf says: a local install
# (copied from this folder) and the claude.ai one (from GitHub) are then identical byte for byte.
* text=auto eol=lf
# Windows scripts are stored byte-exact: cmd parsing depends on CRLF, tests compare bytes.
*.cmd -text
*.bat -text
*.ps1 -text
